{
  "name": "vewave",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "start": "vite --port 3000",
    "build": "vite build && tsc",
    "routes:gen": "node scripts/generate-route-tree.mjs",
    "typecheck": "npm run routes:gen && npm run typecheck:tsc",
    "typecheck:tsc": "tsc -p tsconfig.json --noEmit",
    "serve": "vite preview",
    "api:gen": "orval --config orval.config.ts && node -e \"setTimeout(() => {}, 2000)\" && prettier --write src/core/api/generated",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:eslint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix": "npm run format && npm run lint:fix",
    "check": "npm run routes:gen && npm run format:check && npm run lint && npm run typecheck:tsc && npm run test",
    "prepare": "husky",
    "lint-staged": "lint-staged"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.1.1",
    "@origin-space/image-cropper": "^0.1.9",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@simplewebauthn/browser": "^13.3.0",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/eslint-config": "^0.4.0",
    "@tanstack/react-query": "^5.81.5",
    "@tanstack/react-router": "^1.114.3",
    "@tanstack/react-router-devtools": "^1.114.3",
    "@tanstack/router-plugin": "^1.114.3",
    "axios": "^1.16.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "^16.9.0",
    "fumadocs-ui": "^16.9.0",
    "gsap": "^3.15.0",
    "lucide-react": "^0.513.0",
    "motion": "^12.38.0",
    "radix-ui": "^1.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.60.0",
    "sonner": "^2.0.5",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.0.6",
    "use-callback-ref": "^1.3.3",
    "use-sidecar": "^1.1.3",
    "zod": "^4.0.5",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tanstack/router-generator": "^1.128.6",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "lint-staged": "^16.1.2",
    "orval": "^8.18.0",
    "prettier": "^3.5.3",
    "tw-animate-css": "^1.3.4",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.6",
    "web-vitals": "^4.2.4"
  }
}
